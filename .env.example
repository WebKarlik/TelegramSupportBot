# Скопируйте этот файл в .env и заполните.  cp .env.example .env

# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID суперадминов через запятую (видят все обращения и добавляют/удаляют админов).
# Свой ID можно узнать у @userinfobot.
SUPERADMIN_IDS=

# (необязательно) Стартовый список обычных админов через запятую — добавляется
# в базу только при первом запуске. Дальше админами управляет суперадмин (/addadmin).
ADMINS=

# Название сервиса в приветствии и ответах
SUPPORT_NAME=PotatVPN

# ---- Мини-приложение (панель поддержки) ----
# Домен, который указывает на этот сервер (A-запись). Caddy сам получит HTTPS-сертификат.
# Пусто — бот работает без мини-приложения, только через чат.
WEBAPP_DOMAIN=
# Включает контейнер Caddy (HTTPS). Раскомментируйте вместе с WEBAPP_DOMAIN.
# COMPOSE_PROFILES=webapp

# Вместо WEBAPP_DOMAIN можно указать полный адрес, если HTTPS настроен иначе (nginx, Cloudflare Tunnel...):
# WEBAPP_URL=https://support.example.com/

# ---- Тонкая настройка (можно не трогать) ----
# RATE_LIMIT_MESSAGES=5
# RATE_LIMIT_WINDOW=30
# WEB_PORT=8080
